{
  "name": "spike-legends",
  "version": "16.0.0",
  "private": true,
  "description": "Haikyuu Legends V16: six position face-off reveals before friend and bot matches, improved stat-aware rally events and commentary.",
  "scripts": {
    "start": "node server.js",
    "test": "node test/server-smoke.js",
    "test:engine": "node test/engine.test.js",
    "test:roster": "node test/roster.test.js",
    "test:v3": "node test/v3-logic.test.js && node test/v3-server-draft.test.js && node test/engine.test.js && node test/roster.test.js",
    "test:v4": "node test/v4-rules.test.js && node test/v3-logic.test.js && node test/v3-server-draft.test.js && node test/engine.test.js && node test/roster.test.js",
    "test:v5": "node test/v5-overhaul.test.js && npm run test:v4",
    "test:v6": "node test/v6-premium.test.js && npm run test:v5",
    "test:v7": "node test/portraits.test.js && npm run test:v6",
    "test:v8": "node test/v8-astral.test.js && npm run test:v7",
    "test:v9": "node test/v9-school.test.js && npm run test:v8",
    "test:v10": "node test/v10-unique-quests.test.js && npm run test:v9",
    "test:v11": "node test/v11-nationals.test.js && npm run test:v10",
    "test:v12": "node test/v12-video-style.test.js && npm run test:v11",
    "test:v13": "node test/v13-card-pack.test.js && npm run test:v12",
    "test:v14": "node test/v14-rivalry-roster.test.js && npm run test:v13",
    "test:v15": "node test/v15-neon-arena.test.js && npm run test:v14",
    "test:v16": "node test/v16-showdown.test.js && npm run test:v15"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=20"
  }
}
